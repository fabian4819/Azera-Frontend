# Target backend untuk proxy "/api" milik vite dev server (server-to-server,
# jadi tidak kena CORS meski cross-origin). Kosongkan/hapus baris ini untuk
# fallback ke default (production: https://azerakol.id). Ganti ke
# http://localhost:4000 kalau mau dev melawan backend lokal.
VITE_API_PROXY_TARGET=https://azerakol.id
